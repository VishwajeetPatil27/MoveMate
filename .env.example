# MoveMate Environment Configuration Template
# Copy this file to .env for local development settings.
# NEVER commit real credentials, passwords, or production secrets to Git.

# ============================================================
# SERVER & APP CONFIGURATION
# ============================================================
PORT=8080
SPRING_PROFILES_ACTIVE=dev
API_BASE_URL=http://localhost:8080/api/v1
FRONTEND_URL=http://localhost:5173

# ============================================================
# MYSQL DATABASE CONFIGURATION
# ============================================================
DATABASE_URL=jdbc:mysql://localhost:3306/movemate_db?useSSL=false&serverTimezone=UTC&allowPublicKeyRetrieval=true
DATABASE_USERNAME=root
DATABASE_PASSWORD=rootpassword

# ============================================================
# REDIS CACHE CONFIGURATION
# ============================================================
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# ============================================================
# JWT SECURITY CONFIGURATION
# ============================================================
# Must be at least 256 bits (32 characters) secret key
JWT_SECRET=movemate_super_secret_jwt_key_for_relocation_platform_2026_secure
JWT_EXPIRATION_MS=86400000
JWT_REFRESH_EXPIRATION_MS=604800000

# ============================================================
# FILE STORAGE CONFIGURATION (AWS S3 / CLOUDINARY)
# ============================================================
AWS_S3_BUCKET=movemate-assets-bucket
AWS_REGION=ap-south-1
AWS_ACCESS_KEY_ID=your_aws_access_key
AWS_SECRET_ACCESS_KEY=your_aws_secret_key
